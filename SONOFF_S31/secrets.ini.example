; Template for secrets.ini (which is gitignored). Copy this file to secrets.ini and
; fill in your network. These become the compile-time WiFi fallback (WIFI_DEFAULT_SSID /
; WIFI_DEFAULT_PASS) used when LittleFS /net_auth.txt is absent. Leave blank to ship a
; firmware with no default (an unprovisioned device then opens its /config softAP).
[secrets]
wifi_ssid = YOUR_SSID
wifi_pass = YOUR_PASSWORD
